# Copy to .env for local work. Replace every REPLACE_* value locally.
# Never commit .env, real credentials, or user access tokens.

# Application
APP_NAME=Realtime Chat Prototype
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_PUBLIC_URL=http://localhost:8000

# Matrix homeserver. Browser clients use the public URL; containers use the
# internal service URL. Replace the example server name before creating users.
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_INTERNAL_URL=http://synapse:8008
SYNAPSE_PUBLIC_URL=http://127.0.0.1:8008
SYNAPSE_IMAGE_TAG=v1.163.2
SYNAPSE_HTTP_PORT=8008
SYNAPSE_HOST_PORT=8008
SYNAPSE_LOG_LEVEL=INFO

# PostgreSQL bootstrap and dedicated Synapse role. The actual passwords belong
# only in the ignored local .env file.
POSTGRES_IMAGE_TAG=16.15
POSTGRES_SUPERUSER=postgres
POSTGRES_DATABASE=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_BOOTSTRAP_PASSWORD
LOCAL_UID=1000
LOCAL_GID=1000

# Synapse PostgreSQL container connection. Do not publish/map container port
# 5432 to the host; connect over its private Compose network instead.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SYNAPSE_DATABASE_NAME=synapse
SYNAPSE_DATABASE_USER=synapse
SYNAPSE_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_SYNAPSE_DATABASE_PASSWORD

# FastAPI uses a separate PostgreSQL container, database, role, and private
# network. Neither PostgreSQL service publishes a host port.
APP_POSTGRES_IMAGE_TAG=16.15
APP_DATABASE_HOST=app-postgres
APP_DATABASE_PORT=5432
APP_DATABASE_NAME=chat_app
APP_TEST_DATABASE_NAME=chat_app_test
APP_DATABASE_ADMIN_USER=chat_app_admin
APP_DATABASE_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_APP_DATABASE_ADMIN_PASSWORD
APP_DATABASE_USER=chat_app_app
APP_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_APP_DATABASE_PASSWORD
APP_DATABASE_POOL_SIZE=5
APP_DATABASE_MAX_OVERFLOW=5
APP_REGISTRATION_ENABLED=false

# FastAPI application JWT. This key signs only app API tokens and must not be
# reused as, or presented in place of, a Synapse-issued Matrix access token.
APP_JWT_ISSUER=realtime-chat-api
APP_JWT_AUDIENCE=realtime-chat-api
APP_JWT_ALGORITHM=HS256
APP_JWT_TTL_SECONDS=900
APP_JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_LOCAL_SIGNING_KEY
APP_REFRESH_TOKEN_TTL_SECONDS=2592000
APP_REFRESH_COOKIE_SECURE=false
APP_LOGIN_RATE_LIMIT_ATTEMPTS=10
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
APP_PLAN_ENTITLEMENTS={"directory.search":["free","pro","enterprise"],"profile.extended":["pro","enterprise"]}
SYNAPSE_REQUEST_TIMEOUT_SECONDS=3.0

# Optional shared identity provider / controlled Synapse integration.
# The provider may be shared, but register separate OIDC clients/audiences.
OIDC_ISSUER_URL=https://identity.example.test/
APP_OIDC_CLIENT_ID=REPLACE_WITH_FASTAPI_OIDC_CLIENT_ID
APP_OIDC_CLIENT_SECRET=REPLACE_WITH_FASTAPI_OIDC_CLIENT_SECRET
SYNAPSE_OIDC_CLIENT_ID=REPLACE_WITH_SYNAPSE_OIDC_CLIENT_ID
SYNAPSE_OIDC_CLIENT_SECRET=REPLACE_WITH_SYNAPSE_OIDC_CLIENT_SECRET
# Configure only when server-side account provisioning requires this.
SYNAPSE_ADMIN_ACCESS_TOKEN=REPLACE_WITH_SERVER_SIDE_ADMIN_TOKEN_IF_REQUIRED

# Upload policy (10 MiB is a planning default, not a verified server limit).
MAX_UPLOAD_SIZE_BYTES=10485760

# Benchmark planning defaults. Reports are generated locally and ignored by Git.
BENCHMARK_SCENARIOS=50,100,500
BENCHMARK_DURATION_SECONDS=300
BENCHMARK_RAMP_UP_SECONDS=60
BENCHMARK_TARGET_URL=http://localhost:8000
BENCHMARK_REPORT_DIR=scripts/benchmark/reports
